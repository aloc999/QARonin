[run]
# No `source` here on purpose: every coverage run passes explicit --cov
# targets (Makefile `coverage`, CI coverage jobs). A pinned source list breaks
# per-suite runs where those modules are not importable. branch=True must stay
# so parallel runs combine (statement+branch data cannot mix).
branch = True

[report]
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    raise AssertionError
    if TYPE_CHECKING:
