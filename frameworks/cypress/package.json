{
  "name": "@qaronin/cypress",
  "version": "1.0.0",
  "private": true,
  "description": "QARonin Cypress E2E + component suite (RoninShop parity)",
  "scripts": {
    "test": "cypress run",
    "test:e2e": "cypress run --e2e",
    "test:smoke": "cypress run --e2e --spec 'cypress/e2e/smoke.cy.js'",
    "test:component": "cypress run --component",
    "open": "cypress open"
  },
  "devDependencies": {
    "cypress": "^15.21.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.0",
    "vite": "^8.0.0"
  }
}
